{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "typle/typle-laravel",
    "type": "project",
    "description": "The Laravel backend of the comparison of the Typle backends (docs/backend-compare.md).",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17",
        "laravel/octane": "^2.12"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
